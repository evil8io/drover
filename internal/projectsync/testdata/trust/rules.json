{
  "annotation": "drover.evil8.io/trust-policy",
  "statusAnnotation": "managed.drover.evil8.io/trust-policy-status",
  "maxStatements": 3,
  "audience": "https://openbao.example.com",
  "loginTokenTTL": "5m",
  "jwtIssuers": {
    "github": {
      "requiredClaims": [
        "repository_id"
      ],
      "allowedClaims": {
        "ref": [
          "refs/heads/main",
          "refs/heads/release"
        ]
      }
    },
    "gitlab": {
      "requiredClaims": [
        "project_id"
      ]
    },
    "cluster": {
      "requiredClaims": [
        "sub"
      ]
    }
  },
  "aws": {
    "enabled": true,
    "allowedAccounts": [
      "123456789012"
    ]
  }
}
